PORT=4000
JWT_SECRET=change-me-in-production

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/korovushkino
# или отдельно:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=korovushkino

# SMTP (Timeweb / другой провайдер)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASS=secret
SMTP_FROM=Коровушкино <noreply@example.com>

# Отключить вход по коду на почте (вход только по email, без SMTP)
AUTH_EMAIL_CODE_DISABLED=true

# Админ-панель: почты через запятую, которым разрешён вход
ADMIN_ALLOWED_EMAILS=admin@example.com

# Аварийный пароль (вводится в поле почты, если SMTP недоступен)
ADMIN_EMERGENCY_PASSWORD=change-me-emergency
